# Leave unset for local dev - falls back to a SQLite file at SQLITE_PATH.
# Set to a postgres:// URL in production.
DATABASE_URL=

# Only used when DATABASE_URL is unset.
SQLITE_PATH=./data/wall.db

# HTTP + WebSocket port.
PORT=8787

# Salts the IP hash used only for rate limiting - never used to identify
# anyone. Set a fixed value in production so rate-limit state has a stable
# (still anonymous) identity across restarts; if unset, a random salt is
# generated at boot, which is fine but means buckets reset on every deploy.
IP_HASH_SALT=
