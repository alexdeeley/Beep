{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "todo",
  "main": "server/worker.ts",
  "compatibility_date": "2025-06-01",

  // The app is static (built into ./public by build.mjs); client routes
  // fall back to index.html. /api/* always reaches the Worker.
  "build": { "command": "node build.mjs --prod" },
  "assets": { "directory": "./public", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": true },

  // ONE SQLite-backed Durable Object holds the database and the reminder alarm.
  "durable_objects": { "bindings": [{ "name": "VAULT", "class_name": "Vault" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Vault"] }],

  // Secrets (wrangler secret put, or the TODO_RECOVERY_KEY repository secret
  // through the deploy workflow): TODO_RECOVERY_KEY - the only way to set or
  // reset the PIN. Without it nobody, including a stranger who finds the
  // URL, can set a PIN and get in.
  "vars": { "ENVIRONMENT": "production", "VAPID_SUBJECT": "mailto:alexanderdeeley@gmail.com" },
  "observability": { "enabled": true },
  "routes": [{ "pattern": "todo.deeley.org", "custom_domain": true }]
}
