{
  "name": "todo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "todo.deeley.org: a private, PIN-locked personal to-do list with reminders, as an installable web app.",
  "scripts": {
    "build": "node build.mjs --prod",
    "dev": "node build.mjs && node --no-warnings dev/local-server.mjs",
    "start": "node --no-warnings dev/local-server.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.sw.json && tsc -p tsconfig.server.json && tsc -p tsconfig.node.json",
    "test": "node --no-warnings --test --test-timeout=60000 tests/*.test.ts",
    "test:browser": "node build.mjs && node --no-warnings dev/browser-test.mjs",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261001.1",
    "@types/node": "^26.6.4",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  }
}
