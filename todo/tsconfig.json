{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "strict": true, "noEmit": true,
    "allowImportingTsExtensions": true, "verbatimModuleSyntax": true, "isolatedModules": true,
    "skipLibCheck": true, "noUnusedLocals": true, "noFallthroughCasesInSwitch": true, "types": []
  },
  "include": ["client/main.ts", "server/tasks.ts", "server/driver.ts", "server/db.ts"]
}
