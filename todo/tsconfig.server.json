{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "WebWorker"], "strict": true, "noEmit": true,
    "allowImportingTsExtensions": true, "verbatimModuleSyntax": true, "isolatedModules": true,
    "skipLibCheck": true, "noUnusedLocals": true, "noFallthroughCasesInSwitch": true,
    "types": ["@cloudflare/workers-types/experimental"]
  },
  "include": ["server/**/*.ts"],
  "exclude": ["server/node-driver.ts"]
}
