{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "roll",
  "main": "src/worker.js",
  "compatibility_date": "2025-06-01",

  // index.html, styles.css and /js/* are served straight from ./public.
  // Anything that isn't a real file - including client-side routes like
  // /game/K7PX - falls back to index.html (a small SPA). /api/* always
  // reaches the Worker first (run_worker_first), never the SPA fallback.
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },

  // One Durable Object per game room.
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "RollRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RollRoom"] }],

  "observability": { "enabled": true },

  "routes": [{ "pattern": "roll.deeley.org", "custom_domain": true }]
}
