# Copy this file to .env and fill in real values. Never commit .env.
# See README.md for a full walkthrough of where each value comes from.

# ---- OpenAI (research, verification, caption, vision QA, and the daily
# abstract art image - IMAGE_GEN_MODEL is required, not optional, since
# it generates the actual published image each day) ----
OPENAI_API_KEY=
RESEARCH_MODEL=gpt-4.1
VERIFICATION_MODEL=gpt-4.1
CAPTION_MODEL=gpt-4.1
QA_VISION_MODEL=gpt-4.1
IMAGE_GEN_MODEL=gpt-image-1
ART_MAX_GENERATION_ATTEMPTS=3

# ---- Bluesky (AT Protocol - official publishing target) ----
# BLUESKY_IDENTIFIER is your handle (e.g. yourname.bsky.social) or the
# email you sign in with. BLUESKY_APP_PASSWORD is generated under
# Settings -> App Passwords in the Bluesky app - never your main password.
BLUESKY_IDENTIFIER=
BLUESKY_APP_PASSWORD=
BLUESKY_SERVICE=https://bsky.social
BLUESKY_MAX_PUBLISH_ATTEMPTS=3

# ---- Object storage (Cloudflare R2 or any S3-compatible bucket) ----
# STORAGE_PROVIDER: "r2" | "s3" | "local"  ("local" disables remote upload,
# useful for development when you just want to inspect files on disk)
STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
# If using a generic S3-compatible bucket instead of R2, you can use these
# instead of (or alongside) the R2_* variables above:
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=
# S3_PUBLIC_BASE_URL=
# S3_ENDPOINT=
# S3_REGION=auto

# ---- Scheduling / timezone ----
APP_TIMEZONE=America/Los_Angeles
PUBLISH_TIME_LOCAL=08:00

# ---- Image output ----
IMAGE_FEED_WIDTH=1080
IMAGE_FEED_HEIGHT=1350
IMAGE_STORY_WIDTH=1080
IMAGE_STORY_HEIGHT=1920
ENABLE_STORY_RENDER=false
IMAGE_FORMAT=png
IMAGE_JPEG_QUALITY=92

# ---- Selection tuning ----
MAX_MAJOR_EVENTS=7
MIN_MAJOR_EVENTS=3
MAX_BIRTHS=5
MIN_BIRTHS=0
MAX_DEATHS=5
MIN_DEATHS=0
MAX_INCIDENTS=3
MIN_INCIDENTS=0
MIN_VERIFICATION_CONFIDENCE=0.72
MIN_AUTHORITATIVE_SOURCES=1

# ---- Research volume ----
MIN_CANDIDATES=20
MAX_CANDIDATES=40

# ---- Brand ----
BRAND_THEME=classic_gold
ROTATE_THEMES=false
HASHTAGS="#OnThisDay #History #Past #TodayInHistory"
SOURCE_CREDIT_LINE=Research sources include: Library of Congress, NASA, NPS, NOAA, Smithsonian, official archives and institutional sources.

# ---- Legacy: decorative motifs for the old HTML/CSS text infographic.
# The daily pipeline now always generates abstract art (IMAGE_GEN_MODEL
# above) and no longer calls this - it only matters if you manually run
# the old renderer (src/render/renderInfographic.ts, still in the repo
# but unused by `daily`). ----
ENABLE_IMAGE_GENERATION=false

# ---- QA ----
ENABLE_VISION_QA=true

# ---- Storage / paths ----
RUNS_DIR=runs

# ---- Weekly card draw (src/weeklyCard/, .github/workflows/weekly-card.yml) ----
# A fully independent pipeline from the daily app above - separate
# schedule, separate state, separate concurrency group. Posts a single
# playing card on a scribbled-notebook still life every Sunday at ~2:22am
# Pacific. WEEKLY_CARD_ANCHOR_DATE is "decade 0" for the once-a-decade
# special post - see src/weeklyCard/decadeCheck.ts. Reuses OPENAI_API_KEY,
# BLUESKY_IDENTIFIER/BLUESKY_APP_PASSWORD, and the R2_* storage vars above.
WEEKLY_CARD_ANCHOR_DATE=2026-08-30
WEEKLY_CARD_MAX_GENERATION_ATTEMPTS=3
WEEKLY_CARD_MAX_QA_REGENERATION_ATTEMPTS=3

# ---- Newswire pipeline (src/newswire/, .github/workflows/news.yml) ----
# A third independent pipeline: an hourly autonomous music release-
# announcement wire that replaced the daily art pipeline's schedule
# (daily.yml is now workflow_dispatch-only - see that file). It reuses
# OPENAI_API_KEY, BLUESKY_IDENTIFIER/BLUESKY_APP_PASSWORD, and the R2_*
# storage vars above; R2 also hosts this pipeline's persistent SQLite
# story database (downloaded at the start of each run, uploaded at the
# end - see src/newswire/db/sync.ts). Edit watched-artists.txt at the
# repo root (one artist name per line) to change who it covers, and
# editorial-focus.json for quiet-hours/voice settings - see README.md.
#
# The release itself is detected authoritatively via the Spotify Web API
# (see src/newswire/spotify/client.ts), not LLM web search - it can only
# hallucinate the announcement's prose, never whether a release happened.
# Create a free app at https://developer.spotify.com/dashboard (Client
# Credentials flow only - no user login needed) for these two:
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

NEWS_WRITER_MODEL=gpt-4.1
NEWS_COPYEDIT_MODEL=gpt-4.1-mini
NEWS_FACTCHECK_MODEL=gpt-4.1
NEWS_MAX_STAGE_RETRIES=2
NEWS_STAGE_TIMEOUT_MS=60000
# Hard cap on posts in one hourly edition.
NEWS_MAX_POSTS_PER_EDITION=5
# Object key the story SQLite database is stored/retrieved under in the R2 bucket above.
NEWS_DB_R2_KEY=newswire/story.db
# Path (relative to the repo root) to the user-editable editorial-focus.json.
EDITORIAL_FOCUS_PATH=editorial-focus.json
# Path (relative to the repo root) to the user-maintained artist watchlist, one name per line.
NEWS_ARTIST_LIST_PATH=watched-artists.txt
# How many never-resolved artists to attempt Spotify search resolution for per cycle.
NEWS_ARTIST_RESOLVE_BATCH_SIZE=300
# How many already-resolved artists to check for new releases per cycle (oldest-checked-first rotation).
NEWS_RELEASE_CHECK_BATCH_SIZE=500
# Ignore a "new" release older than this many days (guards against catalog backfill being mistaken for news).
NEWS_RELEASE_LOOKBACK_DAYS=14
