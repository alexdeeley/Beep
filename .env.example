# Copy this file to .env and fill in real values. Never commit .env.
# See README.md for a full walkthrough of where each value comes from.

# ---- OpenAI (research, verification, caption, vision QA, and the daily
# abstract art image - IMAGE_GEN_MODEL is required, not optional, since
# it generates the actual published image each day) ----
OPENAI_API_KEY=
RESEARCH_MODEL=gpt-4.1
VERIFICATION_MODEL=gpt-4.1
CAPTION_MODEL=gpt-4.1
QA_VISION_MODEL=gpt-4.1
IMAGE_GEN_MODEL=gpt-image-1
ART_MAX_GENERATION_ATTEMPTS=3

# ---- Bluesky (AT Protocol - official publishing target) ----
# BLUESKY_IDENTIFIER is your handle (e.g. yourname.bsky.social) or the
# email you sign in with. BLUESKY_APP_PASSWORD is generated under
# Settings -> App Passwords in the Bluesky app - never your main password.
BLUESKY_IDENTIFIER=
BLUESKY_APP_PASSWORD=
BLUESKY_SERVICE=https://bsky.social
BLUESKY_MAX_PUBLISH_ATTEMPTS=3

# ---- Object storage (Cloudflare R2 or any S3-compatible bucket) ----
# STORAGE_PROVIDER: "r2" | "s3" | "local"  ("local" disables remote upload,
# useful for development when you just want to inspect files on disk)
STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
# If using a generic S3-compatible bucket instead of R2, you can use these
# instead of (or alongside) the R2_* variables above:
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=
# S3_PUBLIC_BASE_URL=
# S3_ENDPOINT=
# S3_REGION=auto

# ---- Scheduling / timezone ----
APP_TIMEZONE=America/Los_Angeles
PUBLISH_TIME_LOCAL=08:00

# ---- Image output ----
IMAGE_FEED_WIDTH=1080
IMAGE_FEED_HEIGHT=1350
IMAGE_STORY_WIDTH=1080
IMAGE_STORY_HEIGHT=1920
ENABLE_STORY_RENDER=false
IMAGE_FORMAT=png
IMAGE_JPEG_QUALITY=92

# ---- Selection tuning ----
MAX_MAJOR_EVENTS=7
MIN_MAJOR_EVENTS=3
MAX_BIRTHS=5
MIN_BIRTHS=0
MAX_DEATHS=5
MIN_DEATHS=0
MAX_INCIDENTS=3
MIN_INCIDENTS=0
MIN_VERIFICATION_CONFIDENCE=0.72
MIN_AUTHORITATIVE_SOURCES=1

# ---- Research volume ----
MIN_CANDIDATES=20
MAX_CANDIDATES=40

# ---- Brand ----
BRAND_THEME=classic_gold
ROTATE_THEMES=false
HASHTAGS="#OnThisDay #History #Past #TodayInHistory"
SOURCE_CREDIT_LINE=Research sources include: Library of Congress, NASA, NPS, NOAA, Smithsonian, official archives and institutional sources.

# ---- Legacy: decorative motifs for the old HTML/CSS text infographic.
# The daily pipeline now always generates abstract art (IMAGE_GEN_MODEL
# above) and no longer calls this - it only matters if you manually run
# the old renderer (src/render/renderInfographic.ts, still in the repo
# but unused by `daily`). ----
ENABLE_IMAGE_GENERATION=false

# ---- QA ----
ENABLE_VISION_QA=true

# ---- Storage / paths ----
RUNS_DIR=runs

# ---- Weekly card draw (src/weeklyCard/, .github/workflows/weekly-card.yml) ----
# A fully independent pipeline from the daily app above - separate
# schedule, separate state, separate concurrency group. Posts a single
# playing card on a scribbled-notebook still life every Sunday at ~2:22am
# Pacific. WEEKLY_CARD_ANCHOR_DATE is "decade 0" for the once-a-decade
# special post - see src/weeklyCard/decadeCheck.ts. Reuses OPENAI_API_KEY,
# BLUESKY_IDENTIFIER/BLUESKY_APP_PASSWORD, and the R2_* storage vars above.
WEEKLY_CARD_ANCHOR_DATE=2026-08-30
WEEKLY_CARD_MAX_GENERATION_ATTEMPTS=3
WEEKLY_CARD_MAX_QA_REGENERATION_ATTEMPTS=3

# ---- Newswire pipeline (src/newswire/, .github/workflows/news.yml) ----
# A third independent pipeline: a twice-daily (8am/8pm local, see
# NEWS_POSTING_HOURS_LOCAL) autonomous music news/release-announcement
# wire that replaced the daily art pipeline's schedule (daily.yml is now
# workflow_dispatch-only - see that file). It reuses OPENAI_API_KEY,
# BLUESKY_IDENTIFIER/BLUESKY_APP_PASSWORD, and the R2_* storage vars
# above; R2 also hosts this pipeline's persistent SQLite story database
# (downloaded at the start of each run, uploaded at the end - see
# src/newswire/db/sync.ts). Edit watched-artists.txt at the repo root (one
# artist name per line) to change who it covers, and editorial-focus.json
# for source-tier/quiet-hours/voice settings.
#
# Each cycle rotates through a batch of the watchlist, discovers
# candidates via OpenAI web search, then INDEPENDENTLY re-verifies each
# one with a fresh search that doesn't trust the discovery pass's claims,
# requiring at least 2 corroborating source domains before it's eligible
# to post - the same discover/verify rigor this repo's general-news
# pipeline used, just scoped to an artist batch instead of a topic list.
# A non-priority single posts immediately as a mechanical
# "NEW SINGLE: Artist - Title" line; albums/EPs/compilations wait for the
# Friday "NEW MUSIC FRIDAY" roundup (industry-wide, not just the
# watchlist); every day also gets a "TODAY IN HISTORY" post of
# independently-verified on-this-day music history; and any watchlist
# artist who is an individual person (not a band) gets a one-line
# "HAPPY BIRTHDAY" post on their real, independently-verified birthday.
NEWS_DISCOVERY_MODEL=gpt-4.1-mini
NEWS_VERIFICATION_MODEL=gpt-4.1
NEWS_WRITER_MODEL=gpt-4.1
NEWS_COPYEDIT_MODEL=gpt-4.1-mini
NEWS_FACTCHECK_MODEL=gpt-4.1
NEWS_MAX_STAGE_RETRIES=2
NEWS_STAGE_TIMEOUT_MS=60000
# Hard cap on posts in one edition (news items + priority releases going through the writer - the mechanical single/roundup/history posts aren't capped by this).
NEWS_MAX_POSTS_PER_EDITION=5
# Object key the story SQLite database is stored/retrieved under in the R2 bucket above.
NEWS_DB_R2_KEY=newswire/story.db
# Path (relative to the repo root) to the user-editable editorial-focus.json.
EDITORIAL_FOCUS_PATH=editorial-focus.json
# Path (relative to the repo root) to the user-maintained artist watchlist, one name per line.
NEWS_ARTIST_LIST_PATH=watched-artists.txt
# How many watchlist artists to check (rotation, oldest-checked-first) per cycle. A large watchlist takes many cycles to fully rotate through - that's expected, not a bug. Bumped up from the old hourly-cadence default since there are now only 2 cycles/day.
NEWS_ARTIST_BATCH_SIZE=150
# Local hour (in editorial-focus.json's quietHours.timezone) after which the first Friday cycle posts the NEW MUSIC FRIDAY roundup.
NEWS_WEEKLY_ROUNDUP_HOUR_LOCAL=8
# Comma-separated local hours (0-23, in editorial-focus.json's quietHours.timezone) this pipeline actually runs at. news.yml's cron fires more often than this to survive DST without drifting (see that file) - this is what enforces the real twice-daily cadence: any cycle outside these hours exits immediately, before contacting OpenAI or the story database.
NEWS_POSTING_HOURS_LOCAL=8,20
# How many never-checked watchlist artists get a one-time birth-date lookup per cycle (see src/newswire/birthdays/postBirthdays.ts) - kept small since each candidate needs its own independent verification search, and this is a one-time cost per artist, not a recurring one.
NEWS_BIRTHDATE_BATCH_SIZE=15
