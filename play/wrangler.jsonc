{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "play",
  "main": "src/worker.js",
  "compatibility_date": "2025-06-01",

  // index.html, styles.css and /js/* are served straight from ./public.
  // Anything that isn't a real file - including client-side routes like
  // /room/7K4P - falls back to index.html (a small SPA). /api/* always
  // reaches the Worker first (run_worker_first), never the SPA fallback.
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },

  // One Durable Object per game room (a "match" - several mini-game rounds),
  // plus a single global LEADERBOARD instance shared by every room (see
  // src/leaderboard.js) - always addressed by the same fixed name, so
  // there's only ever one.
  "durable_objects": {
    "bindings": [
      { "name": "MATCHES", "class_name": "MatchRoom" },
      { "name": "LEADERBOARD", "class_name": "Leaderboard" },
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MatchRoom", "Leaderboard"] }],

  "observability": { "enabled": true },

  "routes": [{ "pattern": "play.deeley.org", "custom_domain": true }]
}
