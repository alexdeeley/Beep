# Copy to .env (or export in your shell). Nothing here is secret.

# Browser build (npm run build): where the page finds the game server.
# Leave both empty when the server also serves the page (the default).
VITE_API_URL=
VITE_WS_URL=

# Local server (npm run dev:server)
PORT=8787
NODE_ENV=development
# Where the local server keeps the game between restarts
STATE_FILE=./.soliteam-state.json

# Server (wrangler.jsonc "vars"):
# ALLOWED_ORIGINS=https://soliteam.example.com   extra browser origins allowed to open the game socket
# GAME_OFFSET=0    added to the displayed game number   (the counters are honest by default)
# MOVE_OFFSET=0    added to the displayed move total
