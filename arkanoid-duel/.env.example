# Copy to .env (or export in your shell). Nothing here is secret.

# Browser build (npm run build): where the page finds the game server.
# Leave both empty when the server also serves the page (the default).
VITE_API_URL=
VITE_WS_URL=

# Local server (npm run dev:server)
# CREATE_LIMIT=20   # games one address may create per 10 minutes; raise for load tests
PORT=8787
NODE_ENV=development

# Server (wrangler.jsonc "vars" or `wrangler secret`): extra browser origins allowed to open a game socket.
# ALLOWED_ORIGINS=https://duel.example.com
